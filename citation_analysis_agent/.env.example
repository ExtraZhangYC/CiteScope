# ============================================================
# Citation Analysis Agent - 环境变量配置
# ============================================================
# 使用说明：
#   1. 把下面所有 "你的xxx" 替换成你自己的真实值
#   2. 不需要用到的功能，可以保留空着，但建议至少填 OPENAI_API_KEY
#   3. 修改完保存即可，无需重启代理/IDE，下一次启动会自动重新加载
# ============================================================

# ---------- Flask 服务 ----------
HOST=0.0.0.0
PORT=5000
DEBUG=False

# ---------- 代理（可选） ----------
# 如果你本机开着 7890 端口的代理（Clash / V2Ray 等），把下面注释打开
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
#
# 如果你不需要代理（例如在国内能直连 OpenAI），保持注释即可
# app.py 已经会优先读取这里的代理设置；如果这里没填，就不会设置代理

# ---------- LLM（OpenRouter，与 OpenAI 兼容协议） ----------
# 注册：https://openrouter.ai/
OPENAI_API_KEY=sk-or-replace-me
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# 推荐模型：openai/gpt-4o-mini（付费稳）、meta-llama/llama-3.1-8b-instruct:free（免费）
OPENAI_MODEL=openai/gpt-4o-mini

# ---------- SerpApi（引文下载/搜索用） ----------
# 在 https://serpapi.com/ 注册后获取
# 不填也能启动，但无法使用 /papers/fuzzy_search 和 /papers/download_citations
SERP_API_KEY=your_serpapi_key_here

# ---------- Selenium / ChromeDriver（可选） ----------
# 如果 download/serp_download_tools.py 走 Selenium 路径，需要配置
# 不填也能用 SerpApi 的 HTTP 方式
# CHROME_DRIVER_PATH=C:\path\to\chromedriver.exe
# CHROME_BINARY_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# ---------- 数据库（可选） ----------
# 不填则默认使用项目根目录下的 sqlite 文件
# DATABASE_URL=sqlite:///./citation.db
